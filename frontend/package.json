    "assets:sync:from-web": "python3 ../scripts/sync_assets.py --from web"
  },
  "dependencies": {
    "chart.js": "^4.4.2",
    "clsx": "^2.1.0",
    "lucide-react": "^0.363.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.6"
  }
}
