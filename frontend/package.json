{
  "name": "retail-customer-intelligence",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && cp -r static dist/",
    "preview": "vite preview",
    "audit:lhci": "lhci autorun --config=lighthouserc.cjs",
    "assets:check": "python3 ../scripts/sync_assets.py --check",
