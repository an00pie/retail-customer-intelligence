# INSIGHT.arc Environment Variables Example
# Copy to .env for local development (never commit real secrets)

# Server Configuration
PORT=5055
FLASK_ENV=development

# Google Gemini AI Integration
# Acquire key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_AI_ENABLED=true

# Outbound Messaging Gateway (Optional preview integration)
MESSAGING_PROVIDER=twilio
MESSAGING_API_KEY=your_messaging_api_key_here
MESSAGING_SENDER_ID=+1234567890
